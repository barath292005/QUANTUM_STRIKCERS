# WeatherGPT Backend Configuration Example
# Copy this file to .env and adjust values as needed.

APP_NAME=WeatherGPT
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# CORS Origins (JSON array string or comma-separated)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Weather Engine Configuration
# Options: 'openmeteo' (No API key required) or 'openweather' (Requires OPENWEATHER_API_KEY)
WEATHER_PROVIDER=openmeteo
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_TTL_SECONDS=300

# Database Configuration (PostgreSQL/SQLAlchemy placeholder)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=weathergpt
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weathergpt

# LLM / AI Configuration (Placeholders)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
